rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - owner + org members can read, owner only can write (except role)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        exists(/databases/$(database)/documents/organizations/$(resource.data.orgId)/members/$(request.auth.uid))
      );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
                   !('role' in request.resource.data); // Prevent role modification
      allow delete: if false; // Prevent deletion of user data
    }

    // Organizations collection - members can read, admins only can write
    match /organizations/{orgId} {
      allow read: if request.auth != null && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow update, delete: if request.auth != null &&
                           get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';

      // Members subcollection
      match /members/{memberId} {
        allow read: if request.auth != null && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
        allow create: if request.auth != null && get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
        allow update, delete: if request.auth != null &&
                             get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }
    }

    // Products collection - public read, owning seller only write
    match /products/{productId} {
      allow read: if true; // Public read access
      allow create: if request.auth != null && request.auth.uid == request.resource.data.sellerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.sellerId;
    }

    // Carts collection - owner only read/write
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Wishlist collection - owner only read/write
    match /wishlists/{wishlistId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Orders collection - buyer + seller involved can read, no direct client writes to payment/status fields
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||  // Buyer
        request.auth.uid == resource.data.sellerId   // Seller
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.sellerId) &&
                    request.resource.data.status == resource.data.status &&
                    request.resource.data.paymentStatus == resource.data.paymentStatus;
      allow delete: if false; // Prevent deletion of orders
    }

    // RFQs collection - requester + invited suppliers can read/write appropriately
    match /rfqs/{rfqId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.requesterId ||
        exists(/databases/$(database)/documents/rfq_responses/$(request.auth.uid)) // Invited supplier
      );
      allow create: if request.auth != null && request.auth.uid == request.resource.data.requesterId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.requesterId;

      // RFQ Responses subcollection
      match /rfq_responses/{responseId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/rfqs/$(rfqId)).data.requesterId ||
          request.auth.uid in get(/databases/$(database)/documents/rfqs/$(rfqId)).data.invitedSuppliers
        );
        allow create: if request.auth != null &&
                     exists(/databases/$(database)/documents/rfqs/$(rfqId)) &&
                     request.auth.uid in get(/databases/$(database)/documents/rfqs/$(rfqId)).data.invitedSuppliers;
        allow update, delete: if request.auth != null && request.auth.uid == request.resource.data.supplierId;
      }
    }

    // Chat sessions and messages - participants only
    match /chat_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.participants;
        allow create: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.participants;
        allow update, delete: if request.auth != null && request.auth.uid == request.resource.data.senderId;
      }
    }

    // Business accounts - public storefront fields readable, owner only for private fields
    match /business_accounts/{businessId} {
      allow read: if true; // Public read for storefront fields
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Transactions collection - server-only once payments exist
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId
      );
      allow create: if false; // Server-only via Cloud Function
      allow update, delete: if false; // Server-only
    }
  }
}